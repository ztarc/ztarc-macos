# The version, in the one place it is declared.
#
# UPSTREAM must match the tag upstream/ is pinned to. BUILD counts ZTARC
# releases made against that same upstream, because the two move independently:
# a rebranding fix can ship without fosrl/apple changing at all.
#
# CFBundleShortVersionString becomes "$UPSTREAM.$BUILD". Unlike Windows
# Installer, which compares only the first three fields of ProductVersion,
# CFBundleVersion has no such limit — the fourth component is a real version
# component here, not decoration.
UPSTREAM=0.11.1
BUILD=1
