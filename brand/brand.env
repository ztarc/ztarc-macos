# The brand, in the one place it is declared.
#
# Sourced by scripts/brand.sh. Everything downstream — brand/rules.sed's
# generated rules, the xcodebuild overrides, the .app name, the DMG filename and
# the audit's assertions — reads these, so there is exactly one place to change
# a name and no way for two of them to disagree.
#
# io.ztarc is the reverse-DNS of ztarc.io, the domain the Windows client already
# points at. See ../ztarc-windows/brand/rules.sed.

# What a person sees, and what the .app is called.
BRAND_NAME="ZTARC"

# Bundle identifiers. These are not cosmetic: the app group is the container the
# app and the system extension share, and leaving upstream's would put a ZTARC
# install and a Pangolin install in the same container — the macOS analogue of
# the named-pipe collision ztarc-windows warns about.
BRAND_BUNDLE_ID="io.ztarc.ZTARC"
BRAND_EXT_BUNDLE_ID="io.ztarc.ZTARC.PacketTunnel"
BRAND_APP_GROUP="group.io.ztarc.ZTARC"
BRAND_MACH_SERVICE="group.io.ztarc.ZTARC.PacketTunnel"

# The scheme the auth callback comes back on.
BRAND_URL_SCHEME="ztarc"

# ZTARC has no hosted service, so the cloud endpoint becomes the console.
BRAND_SERVER_URL="https://console.ztarc.io"

# Documentation, terms and privacy pages do not exist yet. Documentation points
# at the marketing site; the links that would have 404'd are removed outright by
# brand/patches/. Re-point these the day the pages exist.
BRAND_SITE_URL="https://ztarc.io"

# Where AGPL-3 obliges us to offer the corresponding source.
BRAND_SOURCE_URL="https://github.com/ztarc/ztarc-macos"

# On-disk names.
BRAND_SUPPORT_DIR="ZTARC"
BRAND_CONFIG_FILE="ztarc.json"

BRAND_COPYRIGHT_HOLDER="ZTARC"

# Upstream identifiers we are replacing. Kept here rather than spelled inline in
# six scripts, so the audit and the rules cannot disagree about what they are
# looking for.
UPSTREAM_NAME="Pangolin"
UPSTREAM_BUNDLE_ID="net.pangolin.Pangolin"
UPSTREAM_APP_GROUP="group.net.pangolin.Pangolin"
UPSTREAM_TEAM_ID="4668XHFAHF"
